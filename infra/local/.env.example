# Copy to .env (git-ignored) and change the values if you like.
# Docker Compose reads .env from this folder automatically.
# These are local development credentials only; never reuse them anywhere else.

POSTGRES_DB=stackfi
POSTGRES_USER=stackfi
POSTGRES_PASSWORD=change-me-local

RABBITMQ_USER=stackfi
RABBITMQ_PASSWORD=change-me-local

# S3-compatible storage (SeaweedFS). Endpoint: http://localhost:8333, region: us-east-1
S3_ACCESS_KEY=stackfi-local
S3_SECRET_KEY=change-me-local-secret
